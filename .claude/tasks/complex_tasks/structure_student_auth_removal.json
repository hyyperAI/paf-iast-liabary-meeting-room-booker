  "dataFlow": {
    "guestBookingFlow": {
      "step1": {
        "action": "User visits /book",
        "component": "StudentDashboard",
        "state": "Check GuestContext",
        "decision": "guestData exists?",
        "ifTrue": "Show booking interface",
        "ifFalse": "Show GuestForm"
      },
      "step2": {
        "action": "User fills GuestForm",
        "component": "GuestForm",
        "state": "Update GuestContext",
        "persistence": "localStorage (guestStudentData)",
        "validation": "Real-time with zod"
      },
      "step3": {
        "action": "User submits form",
        "component": "GuestForm",
        "state": "setGuestStudent()",
        "transition": "Navigate to booking interface"
      },
      "step4": {
        "action": "User selects time slot",
        "component": "TimeSlotGrid",
        "state": "selectedTimeSlot state",
        "trigger": "Open BookingModal"
      },
      "step5": {
        "action": "BookingModal opens",
        "component": "BookingModal",
        "dataSource": "GuestContext (guestData)",
        "prefill": "All fields from guest data"
      },
      "step6": {
        "action": "User submits booking",
        "component": "BookingModal",
        "apiCall": "bookings.create()",
        "payload": {
          "roomId": "selected room",
          "registrationNo": "guestData.registrationNo",
          "applicantName": "guestData.name",
          "applicantPhone": "guestData.phoneNumber",
          "applicantEmail": "guestData.email",
          "applicantSemester": "guestData.semester",
          "groupMemberCount": "from form",
          "members": "from form (optional)"
        }
      },
      "step7": {
        "action": "Booking successful",
        "component": "BookingModal",
        "state": "clearGuestStudent()",
        "ui": "Success toast",
        "transition": "Return to booking interface"
      }
    },
    "authenticatedStudentFlow": {
      "unchanged": true,
      "note": "Existing students can still login and use system as before"
    },
    "adminFlow": {
      "unchanged": true,
      "steps": [
        "User visits /admin",
        "ProtectedRoute checks authentication",
        "Redirect to /login if not authenticated",
        "User enters admin credentials",
        "AdminDashboard loads",
        "Admin can view all bookings (guest + authenticated)"
      ]
    }
  },
  "stateManagement": {
    "guestData": {
      "storage": "GuestContext + localStorage",
      "structure": {
        "registrationNo": "string",
        "name": "string",
        "phoneNumber": "string",
        "email": "string",
        "semester": "string"
      },
      "lifecycle": {
        "created": "When user fills GuestForm",
        "persisted": "localStorage with key 'guestStudentData'",
        "retrieved": "On component mount",
        "cleared": "After successful booking or logout",
        "updated": "On form changes (debounced)"
      }
    },
    "userType": {
      "storage": "AuthContext",
      "values": ["GUEST", "STUDENT", "ADMIN"],
      "determination": {
        "GUEST": "When guestData is set",
        "STUDENT": "When authenticated student logs in",
        "ADMIN": "When admin logs in"
      }
    },
    "routing": {
      "guestRoutes": ["/book"],
      "authRequiredRoutes": ["/admin"],
      "publicRoutes": ["/login", "/unauthorized", "/test-bypass"]
    }
  },
  "componentHierarchy": {
    "App": {
      "children": [
        "AuthProvider",
        "QueryProvider",
        "Router",
        "Routes"
      ],
      "responsibilities": [
        "Route configuration",
        "Provider composition",
        "Global error boundary"
      ]
    },
    "AuthProvider": {
      "children": ["StudentDashboard or AdminDashboard"],
      "provides": ["user", "token", "userType", "login", "logout", "isGuest", "isAdmin"],
      "responsibilities": [
        "Authentication state",
        "Guest mode management",
        "Token expiration"
      ]
    },
    "StudentDashboard": {
      "children": [
        "Conditional: GuestForm OR BookingInterface",
        "BookingInterface: Calendar + TimeSlotGrid"
      ],
      "responsibilities": [
        "Show appropriate UI based on guestData",
        "Handle guest mode transitions",
        "Coordinate booking flow"
      ],
      "states": [
        "guestNoData",
        "guestHasData",
        "authenticatedStudent"
      ]
    },
    "GuestForm": {
      "children": ["Form fields (5)", "Submit button"],
      "responsibilities": [
        "Collect guest student details",
        "Validate input data",
        "Persist to localStorage",
        "Submit to GuestContext"
      ],
      "dependencies": [
        "react-hook-form",
        "zod",
        "localStorage API"
      ]
    },
    "BookingModal": {
      "children": ["Booking details", "Group members form"],
      "responsibilities": [
        "Pre-fill from data source (guest or auth)",
        "Handle booking submission",
        "Show success/error states",
        "Clear guest data on success"
      ],
      "dataSources": ["GuestContext", "AuthContext"]
    }
  },
  "apiChanges": {
    "endpoints": {
      "bookings.create": {
        "current": {
          "requires": ["roomId", "studentId (from auth)"],
          "payload": "Uses authenticated user data"
        },
        "updated": {
          "requires": ["roomId"],
          "optional": ["studentId"],
          "newRequired": [
            "registrationNo",
            "applicantName",
            "applicantPhone",
            "applicantEmail",
            "applicantSemester"
          ],
          "payload": "Guest data OR authenticated user data"
        }
      },
      "otherEndpoints": {
        "status": "No changes required",
        "note": "Admin endpoints unchanged, read-only endpoints work with guest data"
      }
    },
    "dataFormats": {
      "bookingSubmission": {
        "guest": {
          "roomId": "string",
          "registrationNo": "string",
          "applicantName": "string",
          "applicantPhone": "string",
          "applicantEmail": "string",
          "applicantSemester": "string",
          "groupMemberCount": "number",
          "members": "array (optional)"
        },
        "authenticated": {
          "roomId": "string",
          "studentId": "string",
          "registrationNo": "string (from user)",
          "applicantName": "string (from user or form)",
          "applicantPhone": "string (from user or form)",
          "applicantEmail": "string (from user or form)",
          "applicantSemester": "string (from user or form)",
          "groupMemberCount": "number",
          "members": "array (optional)"
        }
      }
    }
  },
  "securityConsiderations": {
    "clientSide": [
      {
        "concern": "Data validation",
        "mitigation": "Zod schemas for all form fields",
